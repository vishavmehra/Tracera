<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="11-repository-intelligence" name="Repository intelligence: the versioned code graph"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Repository intelligence: the versioned code graph&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Indexing only parses text. Every edge says how certain it is, and every snapshot says how fresh it is." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;1  Register&lt;/b&gt;&lt;br&gt;Owner session only. A local path inside TRACERA_REPO_ROOTS, or a fixture: real path, a git work tree, outside the Tracera source tree." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="270" height="200" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2  Request an index&lt;/b&gt;&lt;br&gt;POST /repositories/{id}/index, 20 a minute. One snapshot per repository, commit and extractor version; an existing one is reused." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="352" y="125" width="270" height="200" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;3  Clone and read&lt;/b&gt;&lt;br&gt;Worker job repository.index. A Tracera-owned mirror with hooks, symlinks, submodules and LFS off. Only git plumbing runs; nothing from the repository." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="664" y="125" width="270" height="200" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;4  Parse&lt;/b&gt;&lt;br&gt;@babel/parser for JavaScript and TypeScript, SQL statements. Cached per path and blob, so a new commit re-parses only changed files." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="976" y="125" width="270" height="200" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;5  Link&lt;/b&gt;&lt;br&gt;Nodes and edges. An edge exists only when its target resolves; otherwise it stays unresolved and is counted. The snapshot is ready, or partial when coverage is incomplete." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1288" y="125" width="270" height="200" as="geometry"/></mxCell><mxCell id="v0" value="&lt;b&gt;27 node kinds&lt;/b&gt;&lt;br&gt;repository, revision, directory, file, test_file, package, dependency, function, class, method, variable, interface, type_alias, enum, ui_component, hook, test_case, commit, owner, doc_section, route, page, external_service, event, queue, db_table, config_key" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="490" height="150" as="geometry"/></mxCell><mxCell id="v1" value="&lt;b&gt;22 edge kinds&lt;/b&gt;&lt;br&gt;CONTAINS, DEFINES, IMPORTS, RE_EXPORTS, DEPENDS_ON, CALLS, REFERENCES, IMPLEMENTS, EXTENDS, RENDERS, HANDLES_EVENT, SENDS_REQUEST_TO, ROUTES_TO, READS_FROM, WRITES_TO, PUBLISHES, SUBSCRIBES_TO, TESTS, CONFIGURED_BY, INTRODUCED_OR_CHANGED_BY, OWNED_BY, DOCUMENTED_BY" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="555" y="350" width="490" height="150" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Certainty, coverage, freshness&lt;/b&gt;&lt;br&gt;Each edge is exact, resolved, heuristic or unresolved, with its source location. Coverage counts parse failures and unresolved imports, calls and routes. Freshness compares the snapshot commit with the ref: ref_moved, extractor_outdated or source_unavailable." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1070" y="350" width="490" height="150" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;Queries over a snapshot&lt;/b&gt;&lt;br&gt;Search: graph names and paths, plus fixed-string git grep at the snapshot commit. Node and edge detail with the evidence behind them. Neighbors (depth up to 3). Trace flow from a page to a table (depth up to 10, up or down). Impact (depth up to 4). History: blame and recent commits. Stack-trace mapping onto the commit. Questions and feasibility assessments: a model answers with citations, and a claim counts as supported only with a valid code, fact or graph citation." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="800" height="290" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;Used by&lt;/b&gt;&lt;br&gt;The web explorer, impact and question pages; the MCP search, node, trace, impact and question tools; investigation context collection; patch impact analysis." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="870" y="530" width="690" height="135" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Step or vocabulary" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="140" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="244" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Worker job" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="286" y="860" width="82" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Result" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="432" y="860" width="54" height="22" as="geometry"/></mxCell><mxCell id="lg_t3" value="Next" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="554" y="860" width="39" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="508" y="871" as="sourcePoint"/><mxPoint x="546" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
