<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="05-pipeline-state-machine" name="Investigation stages and status machine"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Investigation stages and status machine&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Ten stages run as separate queued jobs. Each stage records a step; the investigation status changes only along the arrows below." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b&gt;normalize&lt;/b&gt;&lt;br&gt;180 s, non-fatal&lt;br&gt;model" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="270" height="86" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;collect_context&lt;/b&gt;&lt;br&gt;180 s, fatal&lt;br&gt;code only: git and parser" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="352" y="130" width="270" height="86" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;prepare_dependencies&lt;/b&gt;&lt;br&gt;1080 s, non-fatal&lt;br&gt;sandbox" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="664" y="130" width="270" height="86" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;plan_reproduction&lt;/b&gt;&lt;br&gt;300 s, non-fatal&lt;br&gt;model" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="976" y="130" width="270" height="86" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;reproduce_baseline&lt;/b&gt;&lt;br&gt;600 s, non-fatal&lt;br&gt;sandbox" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1288" y="130" width="270" height="86" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;generate_hypotheses&lt;/b&gt;&lt;br&gt;420 s, fatal&lt;br&gt;model" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="270" height="86" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;rank_hypotheses&lt;/b&gt;&lt;br&gt;30 s, fatal&lt;br&gt;code only" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B