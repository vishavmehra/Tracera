gt;running&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="150" height="56" as="geometry"/></mxCell><mxCell id="await" value="&lt;b&gt;awaiting_approval&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="560" width="210" height="56" as="geometry"/></mxCell><mxCell id="done" value="&lt;b&gt;completed&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1100" y="560" width="170" height="56" as="geometry"/></mxCell><mxCell id="failed" value="&lt;b&gt;failed&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FCE8E6;strokeColor=#C62828;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="750" width="140" height="56" as="geometry"/></mxCell><mxCell id="cancel" value="&lt;b&gt;cancelled&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="750" width="160" height="56" as="geometry"/></mxCell><mxCell id="needs" value="&lt;b&gt;needs_input&lt;/b&gt;&lt;br&gt;waiting for more input from the person" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1100" y="740" width="230" height="70" as="geometry"/></mxCell><mxCell id="smnote" value="Every change bumps state_version; clients long-poll for up to 20 s. A step still running 60 s past its stage timeout is marked worker_lost and retried, at most 3 attempts per stage. Specialist roles are labels on each step." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1000" y="625" width="540" height="110" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Code or model stage" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="147" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="251" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Sandbox stage" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="293" y="860" width="104" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="419" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Terminal, good" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap