<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="23-deployment" name="Deployment: hosted demo and local app"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Deployment: hosted demo and local app&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="The same code runs in both. The hosted demo has no Docker, so it stops before the sandbox; the local app can do everything." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="hg" value="Hosted demo (Vercel and Render, free plans)" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="760" height="640" as="geometry"/></mxCell><mxCell id="h0" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;One origin: the Vercel site." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="390" height="80" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;Static web app (apps/web build) with CSP headers. Rewrites /api/*, /healthz and /readyz to the Render service, so cookies, CSRF and OAuth callbacks see one origin." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="269" width="390" height="120" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Render web service tracera-api&lt;/b&gt;&lt;br&gt;Docker image (Node 24 and git) running scripts/start.ts: waits for the database, starts the API (applies migrations), then the worker, the owner seed and the demo repository. TRACERA_SANDBOX_MODE=disabled." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=13;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="413" width="390" height="130" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;Render Postgres tracera-db&lt;/b&gt;&lt;br&gt;Wired into DATABASE_URL over the private network. Free plan: expires after 30 days, no backups." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="567" width="390" height="120" as="geometry"/></mxCell><mxCell id="hl" value="&lt;b&gt;Free-plan limits&lt;/b&gt;&lt;br&gt;0.1 CPU and 512 MB. No disk: the data directory and repositories live in /tmp and are rebuilt after a sleep. Sleeps after 15 min idle; waking takes 40 to 50 s. A login takes about 8 s (scrypt). Analysis only: reproduction and verification are blocked, and apply, commit and push are refused." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="520" y="165" width="260" height="238" as="geometry"/></mxCell><mxCell id="hm" value="&lt;b&gt;Meta Model API&lt;/b&gt;&lt;br&gt;model calls; Muse Spark 1.3, daily budget 5 USD" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=13;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="520" y="433" width="260" height="90" as="geometry"/></mxCell><mxCell id="lg" value="Local app (npm run setup, then npm run local)" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="125" width="720" height="640" as="geometry"/></mxCell><mxCell id="l0" value="&lt;b&gt;npm run setup&lt;/b&gt;&lt;br&gt;Writes .env with generated secrets and ports, starts Postgres with docker compose, runs migrations and seeds the owner." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="860" y="165" width="380" height="120" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;npm run local&lt;/b&gt;&lt;br&gt;Starts the API (port 8787), waits for /healthz, then the worker and the Vite web app (port 5173), which proxies /api to the API. One TRACERA_PUBLIC_URL for all three." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="860" y="309" width="380" height="140" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;Postgres container&lt;/b&gt;&lt;br&gt;Docker Postgres 17 on 127.0.0.1 with a volume." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="860" y="473" width="380" height="100" as="geometry"/></mxCell><mxCell id="lr" value="&lt;b&gt;Local disk&lt;/b&gt;&lt;br&gt;Repositories as local paths under TRACERA_REPO_ROOTS, and the data directory." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1300" y="165" width="240" height="110" as="geometry"/></mxCell><mxCell id="ld" value="&lt;b&gt;Docker Engine&lt;/b&gt;&lt;br&gt;Sandbox and browser images pinned by digest." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1300" y="324" width="240" height="110" as="geometry"/></mxCell><mxCell id="lgit" value="&lt;b&gt;Your git remote&lt;/b&gt;&lt;br&gt;Push uses your own credentials." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1300" y="473" width="240" height="90" as="geometry"/></mxCell><mxCell id="lm" value="&lt;b&gt;Model provider&lt;/b&gt;&lt;br&gt;Meta, an OpenAI-compatible endpoint, or the mock adapter." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1300" y="593" width="240" height="100" as="geometry"/></mxCell><mxCell id="ln" value="Docker is optional at start: without it, verification and reproduction are unavailable until it runs. Apply, commit and push act on repositories on this machine." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="600" width="380" height="110" as="geometry"/></mxCell><mxCell id="diff" value="&lt;b&gt;Same code, different settings.&lt;/b&gt;  Hosted: TRACERA_SANDBOX_MODE=disabled, TRACERA_TRUST_PROXY=true, TRACERA_AUTO_MIGRATE=true, TRACERA_PUBLIC_URL is the Vercel origin.  Local: Docker sandbox, a .env made by npm run setup, TRACERA_PUBLIC_URL is the web app address." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1520" height="64" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Server process" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="111" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="215" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="External service" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="257" y="860" width="126" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="408" y="858" width="28" height="26" as="geometry"/></mxCell><mxCell id="lg_t2" value="Database" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="447" y="860" width="68" height="22" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="537" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t3" value="Limits" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="579" y="860" width="54" height="22" as="geometry"/></mxCell><mxCell id="lg_t4" value="Optional or local link" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="701" y="860" width="169" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h0" target="h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h2" target="hm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l0" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="ld"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="871" as="sourcePoint"/><mxPoint x="693" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
