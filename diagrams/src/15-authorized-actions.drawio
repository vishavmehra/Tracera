<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="15-authorized-actions" name="Authorized actions on an approved patch"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Authorized actions on an approved patch&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Approval changes no files. Apply, commit, push and open pull request are separate requests; authorizing one never covers another." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b&gt;Approve&lt;/b&gt;&lt;br&gt;A review decision in a signed-in session. Records the decision and the outcome seen. No file changes." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="360" height="100" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Apply&lt;/b&gt;&lt;br&gt;The diff goes into the local working tree." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="426" y="125" width="360" height="100" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Commit&lt;/b&gt;&lt;br&gt;The diff becomes a commit on a new branch." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="812" y="125" width="360" height="100" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Push&lt;/b&gt;&lt;br&gt;That branch goes to a named remote, never forced." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1198" y="125" width="360" height="100" as="geometry"/></mxCell><mxCell id="d0" value="Needs the patch proposed and the run awaiting approval. verification_id must be the latest run. Every outcome reason and patch risk is acknowledged to approve. Tokens and MCP get session_required." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;spacingLeft=14;spacingRight=14;align=left;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="360" height="240" as="geometry"/></mxCell><mxCell id="d1" value="The file must have no local edits. git apply --check, then git apply. Reports the commit your checkout is on and the changed files." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;spacingLeft=14;spacingRight=14;align=left;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="426" y="245" width="360" height="240" as="geometry"/></mxCell><mxCell id="d2" value="A temporary worktree is created without a checkout from the verified base commit and the diff is applied to its index only. Your checkout, index and HEAD are untouched. A secret scan of added lines runs first; hooks, signing and filters are off; the branch must not exist." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;spacingLeft=14;spacingRight=14;align=left;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="812" y="245" width="360" height="240" as="geometry"/></mxCell><mxCell id="d3" value="Needs a successful commit action for this patch and a configured remote. Refuses the remote default, the repository default, main and master. Pushes one ref with no force and uses your own git credentials." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;spacingLeft=14;spacingRight=14;align=left;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1198" y="245" width="360" height="240" as="geometry"/></mxCell><mxCell id="chk" value="&lt;b&gt;Checks before apply, commit or push&lt;/b&gt;&lt;br&gt;The patch is approved and a verification outcome is recorded · the repository is a registered local path still inside the allowed roots · acknowledged_outcome equals the recorded outcome · acknowledged_risks is true unless the outcome is verified · an owner session made the request · no other action is running in that repository · the hosted environment refuses with unavailable_in_hosted_environment." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1520" height="120" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;Audit and results&lt;/b&gt;&lt;br&gt;Every attempt writes an audit event. An action row records queued, running, succeeded, failed or refused, with results read back from git's own output." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="490" height="150" as="geometry"/></mxCell><mxCell id="ref" value="&lt;b&gt;Stable refusal codes&lt;/b&gt;&lt;br&gt;working_tree_dirty, patch_does_not_apply, secret_detected, branch_exists, default_branch_refused, non_fast_forward, remote_auth_failed, action_in_progress, push_required, github_token_missing, remote_not_github." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="555" y="655" width="490" height="150" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;Fourth action: open a pull request&lt;/b&gt;&lt;br&gt;After a successful push an owner can open a pull request on GitHub from the pushed branch. Its title and description come from stored rows, never from a model. Diagram 27 shows the steps." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1070" y="655" width="490" height="150" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Person-authorized step" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="169" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="273" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="What happens" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="315" y="860" width="97" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="434" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Shared guard" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="476" y="860" width="97" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
