<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="25-security-controls" name="Security controls and trust boundaries"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Security controls and trust boundaries&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Everything outside the line is untrusted data. Inside it, a model proposes and code decides." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="in" value="&lt;b&gt;Untrusted inputs&lt;/b&gt;&lt;br&gt;repository files and history, logs and stack traces, transcripts, screenshots and recordings, web content, model output, sandbox runner output, provider and Supabase responses" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1520" height="80" as="geometry"/></mxCell><mxCell id="tb" value="Tracera trust boundary" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FFFAF6;strokeColor=#FF6B35;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="1520" height="470" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b&gt;Validate at every boundary&lt;/b&gt;&lt;br&gt;Zod on HTTP input, model output, runner output, provider responses and the environment. Prompts wrap content in untrusted blocks and say never to follow instructions found in it." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="480" height="190" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Redact before models&lt;/b&gt;&lt;br&gt;Keys, tokens, JWTs, private keys and URL credentials are replaced before every model call. Logs redact the authorization header and cookies. Secrets live only in the server environment." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="560" y="280" width="480" height="190" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Models never act&lt;/b&gt;&lt;br&gt;They return strict-schema JSON. Code checks citations and sets every hypothesis state; one function writes verification outcomes. A flag marks injection-like text, advisory only." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1060" y="280" width="480" height="190" as="geometry"/></mxCell><mxCell id="e0" value="&lt;b&gt;Nothing runs on the host&lt;/b&gt;&lt;br&gt;Tests, installs and browsers run in Docker: no network, read-only root, capabilities dropped, limits and deadlines. Installs go through a registry-only proxy. Git runs with hooks off, by argument array." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="480" height="190" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;Identity and scope&lt;/b&gt;&lt;br&gt;Every query is workspace-scoped and a foreign ID returns 404. Cookie changes need the CSRF header and a same-origin Origin. Tokens are scoped, expiring and stored hashed." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="560" y="490" width="480" height="190" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;Per-action authorization&lt;/b&gt;&lt;br&gt;Approval changes no files. Apply, commit and push are separate owner-session requests that echo the outcome seen, never force, and refuse default branches. Tokens and MCP can never make them." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1060" y="490" width="480" height="190" as="geometry"/></mxCell><mxCell id="x0" value="&lt;b&gt;Database and audit&lt;/b&gt;&lt;br&gt;Row Level Security on every public table; the Data API roles have no privileges and the API and worker refuse to start otherwise. audit_events is append-only." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="725" width="490" height="115" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;Honest labels&lt;/b&gt;&lt;br&gt;Mock and placeholder results are labelled [mock]; there is no silent fallback to the mock provider or to the host. Nothing says verified without the stored outcome." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="555" y="725" width="490" height="115" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;Paths and the answer key&lt;/b&gt;&lt;br&gt;A registered repository must lie outside the Tracera source tree and data directory, and is re-checked before use. The benchmark answer key is read only by the evaluator script; no server, web or MCP code reads it." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1070" y="725" width="490" height="115" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Untrusted" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="75" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="179" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Control" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="221" y="860" width="61" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="304" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Hard boundary" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="346" y="860" width="104" height="22" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="472" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t3" value="Further guarantees" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="514" y="860" width="140" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in" target="tb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
