<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="18-google-meet" name="Google Meet ingestion"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Google Meet ingestion&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="A transcript becomes reviewed bug reports. A model proposes candidates; code checks the quotes; a person decides." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b&gt;1  Connect&lt;/b&gt;&lt;br&gt;A signed-in person opens GET /integrations/google/connect. The server builds a Google authorization URL with a random state and a PKCE challenge (S256), kept for 10 minutes and bound to that user." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="360" height="190" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;2  Consent at Google&lt;/b&gt;&lt;br&gt;Scope meetings.space.readonly: read Meet artifacts of conferences the user organized or joined. Google redirects to /integrations/google/callback." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="426" y="125" width="360" height="190" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;3  Callback&lt;/b&gt;&lt;br&gt;The state must belong to the same user. The code and the PKCE verifier are exchanged at Google's token endpoint. Tokens are sealed with AES-256-GCM under TRACERA_ENCRYPTION_KEY, bound to their row and purpose, and never leave the server." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="812" y="125" width="360" height="190" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;4  List and import&lt;/b&gt;&lt;br&gt;Meet REST v2: conference records with transcripts, then transcript entries and participants. Import needs a consent attestation and refuses a transcript already imported." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1198" y="125" width="360" height="190" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;5  Segments&lt;/b&gt;&lt;br&gt;Entries become numbered transcript segments with speaker and time. An uploaded WebVTT, SRT or text transcript (up to 5 MB, same attestation) joins here too." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="360" height="190" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;6  Extract&lt;/b&gt;&lt;br&gt;A pre-filter picks the segments the model sees; one extract_meeting_bugs call proposes candidates with quotes. The transcript is untrusted data." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="426" y="365" width="360" height="190" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;7  Code checks&lt;/b&gt;&lt;br&gt;Every citation must name a segment that was sent and quote it verbatim; a candidate without one is rejected. Duplicates are flagged against candidates and existing bug reports. The model sets no status." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="812" y="365" width="360" height="190" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;8  Human review&lt;/b&gt;&lt;br&gt;A person edits, dismisses or confirms each pending candidate. Confirming creates a bug report and, unless declined, an investigation through the normal services." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1198" y="365" width="360" height="190" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b&gt;States&lt;/b&gt;&lt;br&gt;Meeting: transcribed, processing, extracted, reviewed, failed. Candidate: pending_review, confirmed, dismissed, rejected (set by code only)." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="490" height="130" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Limits&lt;/b&gt;&lt;br&gt;Uploads 10 an hour per user, extraction 20 a minute and confirmation 30 a minute per workspace. Import and review need a session; reads also accept tokens with reports:read." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="555" y="600" width="490" height="130" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Where it is used&lt;/b&gt;&lt;br&gt;The Meetings workspace in the web app and the REST API." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1070" y="600" width="490" height="130" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Step" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="39" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="143" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Google" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="185" y="860" width="54" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="261" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Model call or notes" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="303" y="860" width="147" height="22" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="472" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t3" value="Security or human decision" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="514" y="860" width="198" height="22" as="geometry"/></mxCell><mxCell id="lg_t4" value="Next" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="860" width="39" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="b0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="335"/><mxPoint x="220" y="335"/></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="734" y="871" as="sourcePoint"/><mxPoint x="772" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
