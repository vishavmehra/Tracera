<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="21-database-overview" name="Database overview"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Database overview&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="PostgreSQL 17 through Drizzle. Top-level records carry a workspace id and child rows reach it through their parent. Row Level Security is on for every public table." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="g0" value="Identity and access" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="490" height="235" as="geometry"/></mxCell><mxCell id="g0t" value="&lt;b&gt;users&lt;/b&gt;  email, scrypt password hash, disabled flag&lt;br&gt;&lt;b&gt;workspaces&lt;/b&gt;&lt;br&gt;&lt;b&gt;workspace_members&lt;/b&gt;  role owner or member&lt;br&gt;&lt;b&gt;sessions&lt;/b&gt;  sha256 of the cookie secret, 7 days&lt;br&gt;&lt;b&gt;api_tokens&lt;/b&gt;  sha256 of the token, scopes, expiry" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="52" y="161" width="466" height="191" as="geometry"/></mxCell><mxCell id="g1" value="Repositories and graph" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="555" y="125" width="490" height="235" as="geometry"/></mxCell><mxCell id="g1t" value="&lt;b&gt;repositories&lt;/b&gt;  local_path or fixture, commands, app config&lt;br&gt;&lt;b&gt;repository_snapshots&lt;/b&gt;  one per commit and extractor version&lt;br&gt;&lt;b&gt;graph_nodes&lt;/b&gt;, &lt;b&gt;graph_edges&lt;/b&gt;  per snapshot, with certainty&lt;br&gt;&lt;b&gt;graph_file_cache&lt;/b&gt;  extractions per path and blob&lt;br&gt;&lt;b&gt;assessments&lt;/b&gt;, &lt;b&gt;patch_analyses&lt;/b&gt;&lt;br&gt;&lt;b&gt;dependency_snapshots&lt;/b&gt;  sealed install artifacts" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="567" y="161" width="466" height="191" as="geometry"/></mxCell><mxCell id="g2" value="Reports and evidence" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1070" y="125" width="490" height="235" as="geometry"/></mxCell><mxCell id="g2t" value="&lt;b&gt;bug_reports&lt;/b&gt;  status, source channel, normalization result; may name a repository&lt;br&gt;&lt;b&gt;evidence_assets&lt;/b&gt;  blob sha256, kind, origin, provenance, redactions, 90-day retention&lt;br&gt;&lt;b&gt;model_executions&lt;/b&gt;  one row per model run: task, tokens, cost, status" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1082" y="161" width="466" height="191" as="geometry"/></mxCell><mxCell id="g3" value="Investigations" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="490" height="255" as="geometry"/></mxCell><mxCell id="g3t" value="&lt;b&gt;investigations&lt;/b&gt;  of a bug report and a repository; one active per bug report&lt;br&gt;&lt;b&gt;investigation_steps&lt;/b&gt;  per stage and attempt&lt;br&gt;&lt;b&gt;investigation_evidence&lt;/b&gt;  handles and basis&lt;br&gt;&lt;b&gt;hypotheses&lt;/b&gt;  state set by rules&lt;br&gt;&lt;b&gt;sandbox_runs&lt;/b&gt;  every container run&lt;br&gt;&lt;b&gt;patch_proposals&lt;/b&gt;  diff hash, risks, impact&lt;br&gt;&lt;b&gt;verification_runs&lt;/b&gt;  outcome and reasons&lt;br&gt;&lt;b&gt;resolution_reports&lt;/b&gt;  versioned" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="52" y="431" width="466" height="211" as="geometry"/></mxCell><mxCell id="g4" value="Actions, audit and platform" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="555" y="395" width="490" height="255" as="geometry"/></mxCell><mxCell id="g4t" value="&lt;b&gt;authorized_actions&lt;/b&gt;  for a patch: apply, commit or push; one running per repository&lt;br&gt;&lt;b&gt;audit_events&lt;/b&gt;  append-only: a trigger rejects update and delete&lt;br&gt;&lt;b&gt;idempotency_keys&lt;/b&gt;  replayed responses&lt;br&gt;&lt;b&gt;worker_heartbeats&lt;/b&gt;  worker id and sandbox status&lt;br&gt;&lt;b&gt;pgboss schema&lt;/b&gt;  the job queue, with its own tables" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="567" y="431" width="466" height="211" as="geometry"/></mxCell><mxCell id="g5" value="Meetings" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1070" y="395" width="490" height="255" as="geometry"/></mxCell><mxCell id="g5t" value="&lt;b&gt;integration_connections&lt;/b&gt;  sealed Google tokens&lt;br&gt;&lt;b&gt;meeting_sessions&lt;/b&gt;  transcript source, status, consent&lt;br&gt;&lt;b&gt;transcript_segments&lt;/b&gt;  numbered, with speaker and time&lt;br&gt;&lt;b&gt;meeting_candidates&lt;/b&gt;  cited quotes, review status; confirming creates a bug report" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1082" y="431" width="466" height="211" as="geometry"/></mxCell><mxCell id="x0" value="&lt;b&gt;Data API lockdown&lt;/b&gt;&lt;br&gt;Row Level Security is enabled on every public table and the anon and authenticated roles lose all privileges. The API and worker refuse to start if any table is reachable." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="490" height="150" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;Workspace scoping&lt;/b&gt;&lt;br&gt;Every query filters by the caller's workspace, directly or through the parent row, and a foreign ID answers 404." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="555" y="680" width="490" height="150" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;Retention and integrity&lt;/b&gt;&lt;br&gt;Evidence assets are kept 90 days. audit_events cannot be updated or deleted except by a retention purge. Idempotency keys replay a stored response." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1070" y="680" width="490" height="150" as="geometry"/></mxCell><mxCell id="lg_t0" value="References" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="860" width="82" height="22" as="geometry"/></mxCell><mxCell id="lg_t1" value="Scoped to a workspace" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="236" y="860" width="162" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;dashed=1;dashPattern=6 4;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="g0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="bug_report_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="g2"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="432" y="377"/><mxPoint x="1119" y="377"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="871" as="sourcePoint"/><mxPoint x="78" y="871" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="871" as="sourcePoint"/><mxPoint x="228" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
