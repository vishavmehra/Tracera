<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="13-docker-sandbox" name="Docker sandbox architecture"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Docker sandbox architecture&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Repository code and model-written tests run only here. Requests carry data; every isolation setting belongs to the executor." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="g1" value="Test and reproduction runs" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="490" height="500" as="geometry"/></mxCell><mxCell id="t0" value="&lt;b&gt;Every run gets&lt;/b&gt;&lt;br&gt;- no network (--network none)&lt;br&gt;- read-only root filesystem&lt;br&gt;- /tmp as tmpfs: 64 MB, noexec, nosuid, nodev&lt;br&gt;- non-root user 1000:1000&lt;br&gt;- all capabilities dropped, no-new-privileges&lt;br&gt;- default seccomp profile&lt;br&gt;- 1 CPU, 512 MB memory and swap, 128 processes&lt;br&gt;- the run workspace mounted read-only&lt;br&gt;- sealed dependencies mounted read-only&lt;br&gt;- timeout 1 s to 600 s plus an in-container backstop&lt;br&gt;- output capped at 1 MB" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="450" height="310" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;At most 2 runs at once&lt;/b&gt;&lt;br&gt;A request holds only argv, a workspace, an allowlisted environment and a timeout. No stage can weaken the isolation." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="495" width="450" height="110" as="geometry"/></mxCell><mxCell id="g2" value="Dependency preparation" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="555" y="125" width="490" height="500" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;Internal network&lt;/b&gt;&lt;br&gt;Docker --internal: no route and no DNS." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="575" y="165" width="450" height="90" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Install container&lt;/b&gt;&lt;br&gt;npm ci --ignore-scripts --no-audit --no-fund. 2 CPU, 2048 MB, one at a time." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="575" y="277" width="450" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Egress proxy container&lt;/b&gt;&lt;br&gt;The only member of both the internal and an outbound network. Allows only the configured registry origins; refuses private, loopback and link-local targets. Logs every decision." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="575" y="389" width="450" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Seal&lt;/b&gt;&lt;br&gt;A digest of node_modules is stored as a volume artifact, verified before each use and mounted read-only." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="575" y="501" width="450" height="90" as="geometry"/></mxCell><mxCell id="g3" value="Browser reproduction" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1070" y="125" width="490" height="500" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;App container&lt;/b&gt;&lt;br&gt;The repository's start command, --network none, 1 CPU, 1024 MB, workspace read-only." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1090" y="165" width="450" height="130" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Browser container&lt;/b&gt;&lt;br&gt;Joins the app's network namespace (loopback only). A fixed Playwright runner executes validated steps and aborts every request outside the app origin. 2 CPU, 2048 MB." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1090" y="317" width="450" height="130" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;One JSON line: steps, console and page errors, blocked and failed requests, a PNG screenshot. Checked as untrusted output; only real PNG bytes are stored." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1090" y="469" width="450" height="130" as="geometry"/></mxCell><mxCell id="clean" value="Cleanup and availability" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1520" height="195" as="geometry"/></mxCell><mxCell id="k0" value="&lt;b&gt;Cleanup&lt;/b&gt;&lt;br&gt;Containers use --rm, deterministic names per run and labels: tracera.sandbox, instance, investigation, worker, deadline. A retried job replaces its own stale run." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="480" height="140" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;Reaper&lt;/b&gt;&lt;br&gt;Every minute the worker removes runs whose worker has had no heartbeat for 90 s, or that are past their deadline." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="480" height="140" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;No Docker, no fallback&lt;/b&gt;&lt;br&gt;Without Docker mode the executor reports unavailable and the stages are recorded as blocked. Nothing runs on the host and the API never talks to Docker." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1060" y="690" width="480" height="140" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Container or step" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="133" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="237" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Network or limit" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="279" y="860" width="126" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="427" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Key control" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="469" y="860" width="90" height="22" as="geometry"/></mxCell><mxCell id="lg_t3" value="Next" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="627" y="860" width="39" height="22" as="geometry"/></mxCell><mxCell id="e1" value="registry only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="581" y="871" as="sourcePoint"/><mxPoint x="619" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
