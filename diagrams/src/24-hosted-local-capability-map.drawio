r and the pinned images; otherwise it is available." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="362" width="620" height="58" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Patch download&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="330" height="58" as="geometry"/></mxCell><mxCell id="hh4" value="available" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="428" width="270" height="58" as="geometry"/></mxCell><mxCell id="ll4" value="available" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="428" width="270" height="58" as="geometry"/></mxCell><mxCell id="w4" value="An approved patch downloads as a file to apply yourself." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="428" width="620" height="58" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Apply, commit and push&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="494" width="330" height="58" as="geometry"/></mxCell><mxCell id="hh5" value="unavailable" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FCE8E6;strokeColor=#C62828;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="494" width="270" height="58" as="geometry"/></mxCell><mxCell id="ll5" value="available" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="494" width="270" height="58" as="geometry"/></mxCell><mxCell id="w5" value="Hosted refuses with unavailable_in_hosted_environment. Local acts on local-path repositories from an owner session." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="494" width="620" height="58" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Google Meet transcript import&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="330" height="58" as="geometry"/></mxCell><mxCell id="hh6" value="needs configuration" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="270" height="58" as="geometry"/></mxCell><mxCell id="ll6" value="needs configuration" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="560" width="270" height="58" as="geometry"/></mxCell><mxCell id="w6" value="Needs the Google client values and TRACERA_ENCRYPTION_KEY in either environment; available once they are set." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="620" height="58" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;MCP clients&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="626" width="330" height="58" as="geometry"/></mxCell><mxCell id="hh7" value="available" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="626" width="270" height="58" as="geometry"/></mxCell><mxCell id="ll7" value="available" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="626" width="270" height="58" as="geometry"/></mxCell><mxCell id="w7" value="They run on your machine and use a token; they can never apply, commit or push." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="626" width="620" height="58" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Browser extension&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1