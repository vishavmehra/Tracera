elvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="164" width="620" height="58" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Screenshot understanding&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="330" height="58" as="geometry"/></mxCell><mxCell id="hh1" value="available" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="270" height="58" as="geometry"/></mxCell><mxCell id="ll1" value="available" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="230" width="270" height="58" as="geometry"/></mxCell><mxCell id="w1" value="Screenshots are read with the model provider; no Docker is needed." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="230" width="620" height="58" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Recording analysis&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="330" height="58" as="geometry"/></mxCell><mxCell id="hh2" value="available" style="rounded=1;arcSize=8;fontFa