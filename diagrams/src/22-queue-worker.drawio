<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="22-queue-worker" name="Job queue and worker"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Job queue and worker&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="pg-boss runs inside PostgreSQL: no Redis, no broker. A job is created in the same transaction as the rows it belongs to." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API process&lt;/b&gt;&lt;br&gt;boss.send(queue, job, { db }) inside the caller's transaction, so a job exists only if its rows commit. A singleton key per bug report, snapshot, evidence or stage attempt prevents duplicates." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="480" height="160" as="geometry"/></mxCell><mxCell id="pgb" value="&lt;b&gt;PostgreSQL, schema pgboss&lt;/b&gt;&lt;br&gt;retryLimit 1, retryDelay 5 s per queue. Handlers are idempotent; model errors retry inside the gateway." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="480" height="120" as="geometry"/></mxCell><mxCell id="ql" value="&lt;b&gt;Queues and job expiry&lt;/b&gt;&lt;br&gt;intake.normalize 300 s&lt;br&gt;investigation.stage 1200 s&lt;br&gt;repository.index 900 s&lt;br&gt;repository.assess 600 s&lt;br&gt;repository.patch_impact 900 s&lt;br&gt;dependencies.prepare 1500 s&lt;br&gt;evidence.observe 900 s&lt;br&gt;evidence.locate 600 s&lt;br&gt;meeting.extract&lt;br&gt;evidence.recording 1800 s" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;align=left;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="480" height="300" as="geometry"/></mxCell><mxCell id="wk" value="&lt;b&gt;Worker process&lt;/b&gt;&lt;br&gt;One consumer per queue, batchSize 1. At boot it checks migrations and the Data API lockdown, recovers stalled work, then starts consuming." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="600" y="125" width="460" height="140" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Stage runner (investigation.stage)&lt;/b&gt;&lt;br&gt;Locks the investigation row and writes a step per investigation, stage and attempt. Runs the stage under an abort signal with the stage timeout and a cancel flag polled every second. The outcome, the step and the next stage job commit in one transaction. Fatal stages fail the run; others record the failure and continue." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="460" height="240" as="geometry"/></mxCell><mxCell id="ex" value="&lt;b&gt;Executors&lt;/b&gt;&lt;br&gt;Docker executor in docker mode; otherwise an unavailable executor that records sandbox_disabled. The fake executor is for tests only." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="600" y="575" width="460" height="110" as="geometry"/></mxCell><mxCell id="hb" value="&lt;b&gt;Heartbeat every 15 s&lt;/b&gt;&lt;br&gt;worker_heartbeats records the worker id and sandbox status. /readyz and the capabilities list read the newest beat from the last 60 s." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1120" y="125" width="440" height="160" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b&gt;Recovery sweep at start and every 60 s&lt;/b&gt;&lt;br&gt;A step still running 60 s past its stage timeout becomes worker_lost and is retried, at most 3 attempts per stage. Lost index, assessment, patch-impact and dependency jobs are re-queued. Containers of workers silent for 90 s are reaped." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1120" y="320" width="440" height="250" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;Cancel, retry and retention&lt;/b&gt;&lt;br&gt;Cancel sets a database flag; a running worker aborts model calls and kills containers within a second. Retry is for failed runs only: a new attempt of the stage that failed. Dependency artifacts are cleaned at most every 10 minutes." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1120" y="605" width="440" height="165" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Process" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="61" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="165" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Behavior" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="207" y="860" width="68" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="858" width="28" height="26" as="geometry"/></mxCell><mxCell id="lg_t2" value="Queue storage" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="339" y="860" width="104" height="22" as="geometry"/></mxCell><mxCell id="lg_t3" value="Job flow" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="511" y="860" width="68" height="22" as="geometry"/></mxCell><mxCell id="e1" value="send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="pgb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="work" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pgb" target="wk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wk" target="st"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st" target="ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wk" target="hb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hb" target="sw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="871" as="sourcePoint"/><mxPoint x="503" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
