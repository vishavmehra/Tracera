<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="03-monorepo-layout" name="Monorepo layout and module boundaries"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Monorepo layout and module boundaries&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="npm workspaces. Arrows point from importer to imported. Clients reach the server only over HTTP." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;apps/web&lt;/b&gt;&lt;br&gt;React, Vite, Tailwind" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="340" height="70" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;apps/extension&lt;/b&gt;&lt;br&gt;Chrome MV3 bug capture" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="115" width="340" height="70" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;apps/mcp&lt;/b&gt;&lt;br&gt;stdio MCP server, 14 tools" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="115" width="340" height="70" as="geometry"/></mxCell><mxCell id="con" value="&lt;b&gt;packages/contracts&lt;/b&gt;&lt;br&gt;Zod schemas for every request, response, model output and MCP tool; imported by all four apps" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="1080" height="55" as="geometry"/></mxCell><mxCell id="srv" value="apps/server" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="1080" height="550" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Entrypoints&lt;/b&gt;   main-api.ts   main-worker.ts   config.ts (validated environment)   queue.ts (pg-boss queues)" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="335" width="1020" height="46" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;api/&lt;/b&gt;&lt;br&gt;Fastify routes, auth and CSRF hooks, rate limits, one file per feature" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="405" width="300" height="105" as="geometry"/></mxCell><mxCell id="wk" value="&lt;b&gt;worker/&lt;/b&gt;&lt;br&gt;handlers.ts: queue consumers, heartbeat, recovery sweep" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="395" y="405" width="255" height="105" as="geometry"/></mxCell><mxCell id="mods" value="modules/  (35 flat files, no sub-packages)" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="70" y="535" width="580" height="300" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;investigation&lt;/b&gt;&lt;br&gt;investigations, pipeline, normalization, verification, results, report, publication" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="85" y="570" width="270" height="92" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;evidence for models&lt;/b&gt;&lt;br&gt;context, analysis, stack-traces, evidence, bug-reports, visual-evidence, visual-locate, browser-evidence, runtime-evidence" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="365" y="570" width="270" height="92" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;repository intelligence&lt;/b&gt;&lt;br&gt;repositories, workspace, graph, graph-extract, graph-build, graph-queries, graph-insights, patch-impact, patch-analysis, assessment, dependencies" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="85" y="672" width="270" height="106" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;meetings&lt;/b&gt;&lt;br&gt;meetings, meeting-parse, meeting-extract, meeting-google, meeting-integrations" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="365" y="672" width="270" height="106" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;platform&lt;/b&gt;  auth, audit, idempotency" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="85" y="784" width="270" height="44" as="geometry"/></mxCell><mxCell id="inf" value="&lt;b&gt;inference/&lt;/b&gt;&lt;br&gt;gateway.ts, tasks.ts (task registry), providers.ts (meta, openai_compatible), mock.ts, images.ts, segmentation.ts&lt;br&gt;&lt;br&gt;No HTTP, database or module imports." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="405" width="390" height="165" as="geometry"/></mxCell><mxCell id="sbx" value="&lt;b&gt;sandbox/&lt;/b&gt;&lt;br&gt;executor.ts (interface), docker.ts, browser-runner.ts, browser-steps.ts, egress-proxy.ts, seal-tree.ts&lt;br&gt;&lt;br&gt;Reached only from the worker process. No HTTP, database or module imports." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="595" width="390" height="150" as="geometry"/></mxCell><mxCell id="dblib" value="&lt;b&gt;db/&lt;/b&gt; schema, client, migrate, seed     &lt;b&gt;lib/&lt;/b&gt; crypto, fs, git, http, ids, redact, strict-json-schema" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="770" width="390" height="65" as="geometry"/></mxCell><mxCell id="rules" value="Boundary rules" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1170" y="115" width="390" height="380" as="geometry"/></mxCell><mxCell id="rulestext" value="1. Clients import only @tracera/contracts and call the API over HTTP.&lt;br&gt;2. Every request, response, model-output and MCP schema is a Zod schema in contracts.&lt;br&gt;3. Every model call goes through inference/gateway.ts.&lt;br&gt;4. Repository code runs only through the SandboxExecutor in sandbox/.&lt;br&gt;5. Only main-worker.ts builds a model provider and a Docker executor; the API process never does.&lt;br&gt;6. modules/ stay flat files." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1185" y="155" width="360" height="330" as="geometry"/></mxCell><mxCell id="supp" value="Supporting areas" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1170" y="515" width="390" height="330" as="geometry"/></mxCell><mxCell id="suppt" value="&lt;b&gt;scripts/&lt;/b&gt;  dev, start (production supervisor), preflight, setup, local, bench-setup, bench-eval, shop-ui-setup, patch-impact-eval&lt;br&gt;&lt;br&gt;&lt;b&gt;fixtures/&lt;/b&gt;  bench-shop (evaluation repository), shop-ui (demo shop with one planted bug)&lt;br&gt;&lt;br&gt;&lt;b&gt;eval/&lt;/b&gt;  bench-shop manifest and results; the hidden answer key is never read by Tracera code&lt;br&gt;&lt;br&gt;&lt;b&gt;docs/&lt;/b&gt;  specification, architecture, API, data model, decisions, security, release acceptance" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1185" y="555" width="360" height="285" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Shared schemas" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="111" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="215" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Package or folder" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="257" y="860" width="133" height="22" as="geometry"/></mxCell>