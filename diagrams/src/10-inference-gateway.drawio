<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="10-inference-gateway" name="Inference gateway and model routing"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Inference gateway and model routing&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Every model call in Tracera passes through one function. Nothing else imports a provider." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="reg" value="Task registry (inference/tasks.ts)" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="290" height="440" as="geometry"/></mxCell><mxCell id="regt" value="Each task: prompt version, system prompt, Zod output schema, strict JSON schema, reasoning effort, token cap.&lt;br&gt;&lt;br&gt;&lt;b&gt;low&lt;/b&gt;  normalize_bug_report, observe_screenshot, analyze_recording&lt;br&gt;&lt;b&gt;medium&lt;/b&gt;  plan_reproduction, plan_browser_reproduction, answer_question, extract_meeting_bugs&lt;br&gt;&lt;b&gt;high&lt;/b&gt;  generate_hypotheses, generate_patch, assess_feasibility&lt;br&gt;&lt;br&gt;locate_ui_element is a segmentation call, not a chat task." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="52" y="160" width="270" height="395" as="geometry"/></mxCell><mxCell id="mx" value="&lt;b&gt;model_executions&lt;/b&gt;&lt;br&gt;one row per run" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="gw" value="createGateway(...).run(task, input)" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="125" width="700" height="720" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;1  Redact&lt;/b&gt;  secrets in the text: private keys, provider and cloud keys, tokens, JWTs, URL credentials, key=value pairs. Emails optionally. Pixels are sent as they are." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="165" width="660" height="70" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;2  Prepare images&lt;/b&gt;  at most 4 per call, each within the size limit (8 MB by default)." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="246" width="660" height="70" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;3  Hash the request&lt;/b&gt;  sha256 of model, prompt version, redacted text and image hashes." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="327" width="660" height="70" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;4  Check budgets&lt;/b&gt;  daily workspace budget, and per-investigation limits (16 calls, 1 USD by default). Over budget: a budget_exceeded record, no call." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="408" width="660" height="70" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;5  Take a slot&lt;/b&gt;  at most 4 concurrent calls by default." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="489" width="660" height="70" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;6  Call the provider&lt;/b&gt;  per-call timeout (120 s by default). Transient errors retry up to 3 attempts with backoff." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="660" height="70" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;7  Validate&lt;/b&gt;  parse JSON, check the Zod schema. Invalid or truncated: one repair attempt that feeds the problem back. Still invalid: invalid_output." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="651" width="660" height="70" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;8  Record&lt;/b&gt;  one model_executions row: task, prompt version, provider, model, hash, status, tokens, latency, estimated cost, redaction count, attempts, error." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="400" y="732" width="660" height="70" as="geometry"/></mxCell><mxCell id="prov" value="Provider adapters" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1130" y="125" width="430" height="720" as="geometry"/></mxCell><mxCell id="provt" value="Chosen by TRACERA_INFERENCE_PROVIDER. A model per task comes from TRACERA_MODEL_REASONING with per-task overrides; escalation to a second model is off by default." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1145" y="160" width="400" height="120" as="geometry"/></mxCell><mxCell id="meta" value="&lt;b&gt;meta&lt;/b&gt;&lt;br&gt;Meta Model API. Muse Spark 1.3 by default; the only adapter with a segmentation model (SAM 3.1)." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="390" height="100" as="geometry"/></mxCell><mxCell id="oai" value="&lt;b&gt;openai_compatible&lt;/b&gt;&lt;br&gt;Any OpenAI-style endpoint with a base URL and key." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=14;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1150" y="545" width="390" height="90" as="geometry"/></mxCell><mxCell id="mock" value="&lt;b&gt;mock&lt;/b&gt;&lt;br&gt;Deterministic, schema-valid placeholders for tests and offline use. Always labelled [mock]." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1150" y="660" width="390" height="100" as="geometry"/></mxCell><mxCell id="pt" value="&lt;b&gt;Per-task models&lt;/b&gt;&lt;br&gt;TRACERA_MODEL_NORMALIZE, _REPRODUCTION, _HYPOTHESES, _PATCH, _ASSESSMENT and _QUESTION. Vision, segmentation (sam-3.1 by default) and meeting extraction have their own settings." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1150" y="300" width="390" height="100" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Step" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="39" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="143" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Provider call" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="185" y="860" width="104" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="311" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="External provider" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="353" y="860" width="133" height="22" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="511" y="858" width="28" height="26" as="geometry"/></mxCell><mxCell id="lg_t3" value="Data store" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="860" width="82" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g0" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g6" target="g7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="task,&lt;br&gt;input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="meta"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="oai"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="mock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="every run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g7" target="mx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
