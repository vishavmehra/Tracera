<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="02-containers" name="Containers: what runs and what stores state"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Containers: what runs and what stores state&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="One server codebase runs as an API process and a worker process. They share PostgreSQL and a data directory, and never call each other." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="cl" value="Clients" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="400" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;React 19, Vite, TanStack Query" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="55" y="190" width="190" height="80" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;Chrome extension&lt;/b&gt;&lt;br&gt;MV3 popup, editor, service worker" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="190" height="80" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;stdio process of a coding agent" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="55" y="410" width="190" height="80" as="geometry"/></mxCell><mxCell id="srv" value="apps/server: one codebase, two processes" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="1010" height="690" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API process&lt;/b&gt;&lt;br&gt;main-api.ts, Fastify 5&lt;br&gt;&lt;br&gt;REST /api/v1, problem+json errors&lt;br&gt;sessions, tokens, scopes&lt;br&gt;CSRF header and Origin check&lt;br&gt;rate limits and audit events&lt;br&gt;uploads, downloads, long-poll&lt;br&gt;&lt;br&gt;Enqueues jobs. Never calls Docker or a model." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="170" width="280" height="340" as="geometry"/></mxCell><mxCell id="wrk" value="&lt;b&gt;Worker process&lt;/b&gt;&lt;br&gt;main-worker.ts&lt;br&gt;&lt;br&gt;pg-boss consumers, one job at a time per queue&lt;br&gt;stage runner with timeouts and recovery&lt;br&gt;heartbeat every 15 s, sweep every 60 s&lt;br&gt;&lt;br&gt;Runs every model call and every sandbox run." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="170" width="280" height="340" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Inference gateway&lt;/b&gt;&lt;br&gt;redaction, budgets, retries, strict JSON" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="230" height="100" as="geometry"/></mxCell><mxCell id="sbx" value="&lt;b&gt;Sandbox executor&lt;/b&gt;&lt;br&gt;Docker CLI only, no host execution" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="340" width="230" height="100" as="geometry"/></mxCell><mxCell id="hostednote" value="Hosted demo: TRACERA_SANDBOX_MODE=disabled, so stages that need Docker are recorded as blocked." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1080" y="470" width="240" height="80" as="geometry"/></mxCell><mxCell id="state" value="Shared state" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="390" y="600" width="620" height="190" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;rows and the pgboss schema (job queue)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="270" height="120" as="geometry"/></mxCell><mxCell id="dd" value="&lt;b&gt;Data directory&lt;/b&gt;&lt;br&gt;blobs by sha256, git mirrors, run workspaces" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF8F2;strokeColor=#FF6B35;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="270" height="120" as="geometry"/></mxCell><mxCell id="meta" value="&lt;b&gt;Meta Model API&lt;/b&gt;&lt;br&gt;Muse Spark 1.3" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1400" y="190" width="160" height="100" as="geometry"/></mxCell><mxCell id="docker" value="&lt;b&gt;Docker Engine&lt;/b&gt;&lt;br&gt;disposable containers, local only" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#A89888;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1400" y="340" width="160" height="100" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Process" style="text;fontFamily=Helvetica;html=1;whiteSpace=w