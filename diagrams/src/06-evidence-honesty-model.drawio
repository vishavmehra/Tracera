<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="06-evidence-honesty-model" name="Evidence and honesty model"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Evidence and honesty model&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Four kinds of claim, from weakest to strongest. A claim never gets a stronger label than the evidence behind it." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="lad" value="weakest evidence" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=13;fontColor=#7A6C5F;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="200" height="22" as="geometry"/></mxCell><mxCell id="lad2" value="strongest evidence" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=13;fontColor=#7A6C5F;align=right;" vertex="1" parent="1"><mxGeometry x="1360" y="112" width="200" height="22" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;1  Visible&lt;/b&gt;&lt;br&gt;basis: reported&lt;br&gt;&lt;br&gt;What a vision model says an image shows: text, error messages, interface elements. Screenshots, and keyframes of a recording.&lt;br&gt;&lt;br&gt;UI: &quot;Observed in screenshot&quot;, with [live] or [mock].&lt;br&gt;&lt;br&gt;Limit: a person supplied the pixels and a model read them, so it cannot support or contradict a hypothesis alone." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="355" height="370" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2  Inferred&lt;/b&gt;&lt;br&gt;basis: inferred&lt;br&gt;&lt;br&gt;What a model guesses: causes, steps between frames, intentions.&lt;br&gt;&lt;br&gt;UI: &quot;Model inference&quot;, &quot;Possible cause&quot;.&lt;br&gt;&lt;br&gt;Limit: never visible and never verified. Confidence is low, medium or high with a rationale, never a percentage." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="428" y="150" width="355" height="370" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3  Confirmed by repository inspection&lt;/b&gt;&lt;br&gt;basis: observed&lt;br&gt;&lt;br&gt;Code excerpts, code-graph facts, git history and search hits recorded by deterministic tools. Citations are checked against them.&lt;br&gt;&lt;br&gt;UI: &quot;Evidence-supported hypothesis&quot; needs a valid location and a supporting observed citation.&lt;br&gt;&lt;br&gt;Limit: static only. Nothing was run." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="816" y="150" width="355" height="370" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4  Verified by execution&lt;/b&gt;&lt;br&gt;basis: observed&lt;br&gt;&lt;br&gt;Sandbox runs: the reproduction, the test suite, browser steps.&lt;br&gt;&lt;br&gt;UI: &quot;Fix verified against the original reproduction&quot; and &quot;Confirmed by verification&quot;.&lt;br&gt;&lt;br&gt;Limit: only when the stored outcome is verified: the reproduction passed and every check passed." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1204" y="150" width="355" height="370" as="geometry"/></mxCell><mxCell id="handles" value="&lt;b&gt;Handles in a model's evidence pack&lt;/b&gt;    EV-n report text (reported)    CODE-n, COMMIT-n, REPRO-n (observed)    FIND-n tool facts (observed) or model notes (inferred)    SHOT-n screenshot reading (reported)    INFER-n, HYP-n (inferred)" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="1520" height="56" as="geometry"/></mxCell><mxCell id="prov" value="&lt;b&gt;Provenance stored with each model result&lt;/b&gt;&lt;br&gt;task and prompt_version, provider and model, mode (live or mock), placeholder_provider, model_execution_id, source evidence id and sha256, redaction_count" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="490" height="160" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Labels the UI must show&lt;/b&gt;&lt;br&gt;[mock] on anything the mock adapter produced, [live] for a configured provider. &quot;Verified&quot; appears only when verification_runs.outcome is verified. A guess is never styled as a fact." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="555" y="625" width="490" height="160" as="geometry"/></mxCell><mxCell id="who" value="&lt;b&gt;Who sets what&lt;/b&gt;&lt;br&gt;Models return strict JSON and propose. Code validates citations, sets every hypothesis state and writes verification_runs.outcome through one function. A person approves or rejects." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1070" y="625" width="490" height="160" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Claim kind or rule" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="140" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="244" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Static, observed by tools" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="286" y="860" width="190" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="498" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Observed by running code" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="860" width="183" height="22" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="745" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t3" value="Evidence handles" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="787" y="860" width="126" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="123" as="sourcePoint"/><mxPoint x="1350" y="123" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
