<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="12-patch-impact" name="Patch impact analysis"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Patch impact analysis&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="What a patch changes and what that change can reach, computed from static graphs. Nothing is run and nothing is inferred from names alone." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="gi" value="Inputs" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="330" height="720" as="geometry"/></mxCell><mxCell id="i0" value="&lt;b&gt;Two revisions&lt;/b&gt;&lt;br&gt;base and head, optionally compared from their merge base (git diff base...head)." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="290" height="150" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;Or a pasted diff&lt;/b&gt;&lt;br&gt;A unified diff of up to 750,000 characters, applied to the base revision. Give exactly one of head or diff." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="290" height="170" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;Options&lt;/b&gt;&lt;br&gt;depth 1 to 6 (default 4), at most 300 findings (default 100). POST /repositories/{id}/patch-impact queues a repository.patch_impact job." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="525" width="290" height="200" as="geometry"/></mxCell><mxCell id="gs" value="Analysis (computePatchImpact and analyzePatch)" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="125" width="740" height="720" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;1  Compare&lt;/b&gt;  git diff with name-status, numstat and the full diff (no external diff, no textconv): changed files, renames and changed line ranges on both sides." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="430" y="165" width="700" height="100" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2  Graph both sides&lt;/b&gt;  Index the base and head revisions, reusing cached extractions, so every finding comes from a static graph." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="430" y="279" width="700" height="100" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;3  Find changed symbols&lt;/b&gt;  Map changed lines to symbols: added, removed, modified, signature_changed or export_changed. Lines in no symbol stay unattributed." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="430" y="393" width="700" height="100" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;4  Follow the graph&lt;/b&gt;  Walk from each changed symbol up to the depth. A finding keeps its chain of edges; the weakest edge sets its certainty." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="430" y="507" width="700" height="100" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;5  Link tests&lt;/b&gt;  Linked tests are relevant or possible. none_identified is never reported as untested." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="430" y="621" width="700" height="100" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;6  Rate and advise&lt;/b&gt;  Severity by documented rules and confidence by evidence strength, kept apart. Evidenced and plausible risk. Review actions marked evidence or precaution. Limitations and a complete flag." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="430" y="735" width="700" height="100" as="geometry"/></mxCell><mxCell id="go" value="Result and rules" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1190" y="125" width="370" height="720" as="geometry"/></mxCell><mxCell id="o0" value="&lt;b&gt;PatchImpactResult v1&lt;/b&gt;&lt;br&gt;summary, files, symbols, test, dependency, route, schema and manifest changes, findings, tests by symbol, recommended tests (nothing is run), risk, review actions, limitations. Also a Markdown report." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1205" y="165" width="340" height="190" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;Severity&lt;/b&gt;&lt;br&gt;high: direct users of a contract change (removed code, changed signature, type, export, route or table) and observed broken references. medium: indirect users, or users across a package or on a critical path. low: otherwise." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1205" y="375" width="340" height="190" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;Confidence&lt;/b&gt;&lt;br&gt;high when every link is exact or resolved and the file parsed; medium for file-level origins; low when a link is heuristic or the path crosses shared data." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1205" y="585" width="340" height="130" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;Used by&lt;/b&gt;&lt;br&gt;The Impact page, and each proposed patch in an investigation; its relevant tests join the verification run." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=13;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1205" y="735" width="340" height="95" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Step or rule" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="97" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="201" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Rating step" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="243" y="860" width="90" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="355" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Consumers" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="397" y="860" width="75" height="22" as="geometry"/></mxCell><mxCell id="lg_t3" value="Then" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="860" width="39" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gi" target="gs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gs" target="go"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="494" y="871" as="sourcePoint"/><mxPoint x="532" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
