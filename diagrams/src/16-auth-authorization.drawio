<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="16-auth-authorization" name="Authentication and authorization"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Authentication and authorization&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Three ways in, six checks on every request. Workspace scoping applies to every query." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="gin" value="Ways in" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="400" height="720" as="geometry"/></mxCell><mxCell id="w0" value="&lt;b&gt;Password&lt;/b&gt;&lt;br&gt;POST /auth/login. scrypt hash; an unknown account costs the same time. Failed logins: 10 a minute per address, 50 an hour per email. Creates a session." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="360" height="170" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;Google sign-in&lt;/b&gt;&lt;br&gt;Through a Supabase Auth project. The server verifies the provider token itself, then creates the same session (diagram 17)." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="355" width="360" height="150" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Personal access token&lt;/b&gt;&lt;br&gt;Created from a session with POST /tokens for extension, mcp or script clients. Sent as a bearer token, stored as a sha256 hash, 30 days by default and 90 at most." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="525" width="360" height="190" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;Session cookie&lt;/b&gt;&lt;br&gt;tracera_session, 7 days. Only the sha256 of its secret is stored." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="735" width="360" height="90" as="geometry"/></mxCell><mxCell id="gck" value="Checks on every /api/v1 request" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="490" y="125" width="580" height="720" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;1  Authenticate&lt;/b&gt;  Bearer token or session cookie, looked up by hash. Revoked or expired: 401." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="510" y="165" width="540" height="100" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2  CSRF&lt;/b&gt;  Cookie sessions and login need X-Tracera-CSRF: 1 and an Origin equal to TRACERA_PUBLIC_URL, else 403. Bearer tokens carry no ambient credential." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="510" y="279" width="540" height="100" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;3  Route guard&lt;/b&gt;  requireScope for tokens, requireSession, requireOwner." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="510" y="393" width="540" height="100" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;4  Workspace scope&lt;/b&gt;  Every query filters by the caller's workspace. Another workspace's ID answers 404, never 403." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="510" y="507" width="540" height="100" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;5  Rate limits&lt;/b&gt;  Per workspace (index, analysis 20 a minute; search 120; intake 60; uploads 30; actions 20), per MCP token (300 reads, 60 writes), and failed logins." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="510" y="621" width="540" height="100" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;6  Audit&lt;/b&gt;  Sign-ins, token changes, decisions, actions and MCP calls write append-only audit events." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="510" y="735" width="540" height="100" as="geometry"/></mxCell><mxCell id="gro" value="Roles, scopes and limits" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#7A6C5F;fillColor=#FBF8F4;strokeColor=#D4C6B9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1140" y="125" width="420" height="720" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;Roles&lt;/b&gt;&lt;br&gt;owner: registers repositories and authorizes actions. member: everything else a session can do." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1160" y="165" width="380" height="140" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Scopes&lt;/b&gt;&lt;br&gt;reports:read, reports:write, investigations:read, investigations:write, verifications:write, repositories:read." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1160" y="325" width="380" height="140" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Token presets&lt;/b&gt;&lt;br&gt;extension: reports:write. mcp: all six. script: scopes listed explicitly." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1160" y="485" width="380" height="110" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;A token can never&lt;/b&gt;&lt;br&gt;approve a patch, apply, commit or push, create or revoke tokens, register repositories or ask for a screenshot locate: those need a session or an owner." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;fontSize=14;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1160" y="615" width="380" height="190" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Step or rule" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="97" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="201" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Stored credential" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="243" y="860" width="133" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF1E9;strokeColor=#FF6B35;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="398" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Hard limit" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="860" width="82" height="22" as="geometry"/></mxCell><mxCell id="lg_t3" value="Then" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="860" width="39" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gin" target="gck"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gck" target="gro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;fontFamily=Helvetica;html=1;fontSize=13;fontColor=#3D342B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;strokeColor=#7A6C5F;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="544" y="871" as="sourcePoint"/><mxPoint x="582" y="871" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
