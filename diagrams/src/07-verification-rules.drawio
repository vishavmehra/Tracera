<mxfile host="app.diagrams.net" agent="tracera-diagram-gen" version="24.0.0" type="device"><diagram id="07-verification-rules" name="Verification outcome rules"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="titlebar" value="" style="rounded=0;fillColor=#FF6B35;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="56" height="5" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Verification outcome rules&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1520" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="deriveVerificationOutcome(checks) is a pure function and the only writer of verification_runs.outcome. First matching rule wins." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="22" as="geometry"/></mxCell><mxCell id="inp" value="&lt;b&gt;Input: one record per check&lt;/b&gt;&lt;br&gt;kind: reproduction, unit_tests, typecheck, lint, build.   status: passed, failed, inconclusive, blocked, not_attempted.   reason code when a check did not pass" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="1520" height="62" as="geometry"/></mxCell><mxCell id="h0" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="56" height="36" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;Condition on the recorded checks&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="106" y="196" width="540" height="36" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Outcome&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="656" y="196" width="250" height="36" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;What the UI says&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="916" y="196" width="644" height="36" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;1&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="56" height="58" as="geometry"/></mxCell><mxCell id="c0" value="No checks recorded: no verification run exists" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="106" y="242" width="540" height="58" as="geometry"/></mxCell><mxCell id="o0" value="&lt;b&gt;not_attempted&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="656" y="242" width="250" height="58" as="geometry"/></mxCell><mxCell id="u0" value="Not verified" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="916" y="242" width="644" height="58" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="56" height="58" as="geometry"/></mxCell><mxCell id="c1" value="Any check has status failed" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="106" y="308" width="540" height="58" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;failed&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FCE8E6;strokeColor=#C62828;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="656" y="308" width="250" height="58" as="geometry"/></mxCell><mxCell id="u1" value="Verification failed" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="916" y="308" width="644" height="58" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;3&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="56" height="58" as="geometry"/></mxCell><mxCell id="c2" value="The reproduction check passed and every check passed" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="106" y="374" width="540" height="58" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;verified&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="656" y="374" width="250" height="58" as="geometry"/></mxCell><mxCell id="u2" value="Fix verified against the original reproduction" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="916" y="374" width="644" height="58" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="56" height="58" as="geometry"/></mxCell><mxCell id="c3" value="At least one check passed, but rule 3 did not match (no reproduction check, or one not passed)" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="106" y="440" width="540" height="58" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;partially_verified&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="656" y="440" width="250" height="58" as="geometry"/></mxCell><mxCell id="u3" value="Checks passed, but the original failure was not confirmed" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="916" y="440" width="644" height="58" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;5&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="506" width="56" height="58" as="geometry"/></mxCell><mxCell id="c4" value="At least one check is inconclusive; none passed, none failed" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="106" y="506" width="540" height="58" as="geometry"/></mxCell><mxCell id="o4" value="&lt;b&gt;inconclusive&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="656" y="506" width="250" height="58" as="geometry"/></mxCell><mxCell id="u4" value="Verification inconclusive" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="916" y="506" width="644" height="58" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;6&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="56" height="58" as="geometry"/></mxCell><mxCell id="c5" value="Everything else: all checks blocked or not attempted (for example no sandbox)" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="106" y="572" width="540" height="58" as="geometry"/></mxCell><mxCell id="o5" value="&lt;b&gt;blocked&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="656" y="572" width="250" height="58" as="geometry"/></mxCell><mxCell id="u5" value="Verification could not run" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="916" y="572" width="644" height="58" as="geometry"/></mxCell><mxCell id="ex1" value="&lt;b&gt;Reasons&lt;/b&gt;&lt;br&gt;outcome_reasons lists the machine codes that stopped a stronger outcome, such as sandbox_disabled, dependencies_not_prepared or reproduction_check_missing." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="490" height="130" as="geometry"/></mxCell><mxCell id="ex2" value="&lt;b&gt;Never claimed without it&lt;/b&gt;&lt;br&gt;A passing unit-test suite alone cannot give verified. Every row has a table-driven test. Only this function writes the outcome." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="555" y="665" width="490" height="130" as="geometry"/></mxCell><mxCell id="ex3" value="&lt;b&gt;What consumes the outcome&lt;/b&gt;&lt;br&gt;Approval names the verification run it saw. Apply, commit and push must echo the outcome and, unless it is verified, acknowledge the risks." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;fontSize=14;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1070" y="665" width="490" height="130" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#E7F4E8;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t0" value="Verified" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="860" width="68" height="22" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFF3D1;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="172" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t1" value="Needs attention" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="214" y="860" width="118" height="22" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FCE8E6;strokeColor=#C62828;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="354" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t2" value="Failed" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="396" y="860" width="54" height="22" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#F6F1EC;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="472" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t3" value="Not verified" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="514" y="860" width="97" height="22" as="geometry"/></mxCell><mxCell id="lg_s4" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#3D342B;fillColor=#FFFFFF;strokeColor=#D4C6B9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="633" y="862" width="34" height="18" as="geometry"/></mxCell><mxCell id="lg_t4" value="Rule detail" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=13;fontColor=#7A6C5F;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="675" y="860" width="90" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
