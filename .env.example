# Tracera configuration. `npm run setup` creates .env from this file and fills in the secrets with
# generated values. To configure by hand instead, copy this file to .env and replace every
# placeholder. Never commit .env.

# ---------------------------------------------------------------------------------------------
# Required for a local install
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# The API listens on TRACERA_API_HOST:TRACERA_API_PORT. The web app listens on TRACERA_WEB_PORT and
# proxies /api to the API, so the browser only ever talks to the web app's address.
# The API accepts a state-changing request only when its Origin equals TRACERA_PUBLIC_URL, so
# TRACERA_PUBLIC_URL must be exactly the address in the browser's address bar (use 127.0.0.1, not
# localhost). `npm run local` sets it from TRACERA_WEB_PORT for you.
TRACERA_API_HOST=127.0.0.1
TRACERA_API_PORT=8787
TRACERA_WEB_PORT=5173
TRACERA_PUBLIC_URL=http://127.0.0.1:5173

# Postgres. docker compose reads POSTGRES_PASSWORD and POSTGRES_PORT from this file and publishes the
# database on 127.0.0.1 only. The password and the port in DATABASE_URL must match them.
POSTGRES_PASSWORD=change-me-to-a-random-value
POSTGRES_PORT=5432
DATABASE_URL=postgres://tracera:change-me-to-a-random-value@127.0.0.1:5432/tracera
# true applies pending migrations whenever the API starts.
TRACERA_AUTO_MIGRATE=true

# Where Tracera keeps its files (blobs, workspaces, caches, the demo fixture repositories), and the
# folders under which your own repositories may be registered (absolute paths separated by
# semicolons). Both must be outside the Tracera source tree, and a repository folder must not be
# inside the data directory. Empty data directory = ~/.tracera. Empty repository folders = none, so
# only the demo fixtures can be registered.
TRACERA_DATA_DIR=
TRACERA_REPO_ROOTS=

# The first owner account, created by `npm run db:seed`. The password needs at least 12 characters.
TRACERA_SEED_OWNER_EMAIL=owner@example.com
TRACERA_SEED_OWNER_PASSWORD=

# Seals stored integration tokens at rest: 32 random bytes encoded as base64, for example from
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TRACERA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------------------------
# mock | meta | openai_compatible. mock needs no keys, makes no network calls, and labels every
# result as a mock result. Switch to meta once TRACERA_META_API_KEY is set.
TRACERA_INFERENCE_PROVIDER=mock

# Meta (TRACERA_INFERENCE_PROVIDER=meta). Keep the key in this file or the server environment only.
TRACERA_META_API_KEY=
TRACERA_META_BASE_URL=https://api.meta.ai/v1

# Any OpenAI-compatible endpoint (TRACERA_INFERENCE_PROVIDER=openai_compatible). It also needs
# TRACERA_MODEL_REASONING below.
TRACERA_OPENAI_COMPAT_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TRACERA_OPENAI_COMPAT_API_KEY=
TRACERA_OPENAI_COMPAT_PROVIDER_NAME=nebius

# TRACERA_MODEL_REASONING is the model for every task; empty = the provider's default model. The
# lines after it override the model for one task each; empty = TRACERA_MODEL_REASONING.
TRACERA_MODEL_REASONING=
# TRACERA_MODEL_NORMALIZE=
# TRACERA_MODEL_REPRODUCTION=
# TRACERA_MODEL_HYPOTHESES=
# TRACERA_MODEL_PATCH=
# TRACERA_MODEL_ASSESSMENT=
# TRACERA_MODEL_QUESTION=
# TRACERA_MODEL_MEETING=
# One extra, final patch attempt with a stronger model. Needs both lines.
# TRACERA_MODEL_ESCALATION=
# TRACERA_ESCALATION_ENABLED=false

# Screenshots: the model that reads an attached screenshot (empty = a default for the provider), the
# largest image in bytes that may be sent to a model, and the segmentation model that locates a
# named element in a screenshot (only the meta provider hosts one).
# TRACERA_MODEL_VISION=
# TRACERA_MAX_IMAGE_BYTES=8388608
# TRACERA_MODEL_SEGMENT=sam-3.1

# Spending, concurrency, and privacy limits for model calls.
TRACERA_LLM_DAILY_BUDGET_USD=5
TRACERA_LLM_MAX_CONCURRENCY=4
TRACERA_LLM_TIMEOUT_MS=120000
TRACERA_INVESTIGATION_MAX_MODEL_CALLS=16
TRACERA_INVESTIGATION_BUDGET_USD=1
# Redact email addresses from everything sent to a model.
TRACERA_REDACT_EMAILS=true

# ---------------------------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------------------------
# docker runs tests, dependency installs, and reproductions in containers: Docker must be running
# and the images pulled (`npm run setup -- --pull-images`). disabled records those stages as
# blocked instead of running them.
TRACERA_SANDBOX_MODE=docker
# Images must be pinned by digest (name@sha256:...). Empty = the pinned defaults.
# TRACERA_SANDBOX_IMAGE=
# TRACERA_BROWSER_IMAGE=
# TRACERA_SANDBOX_TIMEOUT_MS=120000
# Dependency installs may reach only this registry, through a proxy that allows nothing else.
# TRACERA_DEPS_REGISTRY=https://registry.npmjs.org/
# TRACERA_DEPS_TIMEOUT_MS=600000
# TRACERA_DEPS_KEEP=3
# TRACERA_DEPS_EGRESS_NETWORK=bridge

# ---------------------------------------------------------------------------------------------
# Google Meet import (optional)
# ---------------------------------------------------------------------------------------------
# Create an OAuth client of type "Web application" in a Google Cloud project and register the
# redirect URI below exactly as written. The path is fixed; the origin is the address of the web
# app (TRACERA_PUBLIC_URL). The import is enabled only when all four of GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI, and TRACERA_ENCRYPTION_KEY (above) are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/integrations/google/callback

# ---------------------------------------------------------------------------------------------
# Hosted deployments only (no Docker, behind a reverse proxy). A local install leaves these alone.
# ---------------------------------------------------------------------------------------------
# A hosted instance also sets TRACERA_API_HOST=0.0.0.0, TRACERA_SANDBOX_MODE=disabled, and a
# TRACERA_PUBLIC_URL equal to the public origin of the web app (the one that proxies /api).
# Read the client address from X-Forwarded-For. The login throttle is per address.
# TRACERA_TRUST_PROXY=false
# true makes npm start build the Bench Shop demo repository under TRACERA_DATA_DIR/fixtures when it
# is missing, so it can be registered from the web app.
# TRACERA_DEMO_REPOS=false
# How many times npm start tries to reach the database before it exits non-zero (1 s pause, doubling
# up to 15 s).
# TRACERA_DB_WAIT_ATTEMPTS=6
