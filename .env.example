# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info
TRACERA_API_HOST=127.0.0.1
TRACERA_API_PORT=8787
# The origin the browser uses. Every cookie-authenticated change is checked against its Origin header,
# so this must equal the address in the browser's address bar: the web dev server's address while
# developing, the public origin of the web app (the one that proxies /api) when hosted.
TRACERA_PUBLIC_URL=http://127.0.0.1:8787
# Set to true behind a reverse proxy so the client address is read from X-Forwarded-For (the login
# throttle is per address). Leave false when clients connect directly.
TRACERA_TRUST_PROXY=false

# Postgres (docker compose reads POSTGRES_PASSWORD from .env). Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-random-value
DATABASE_URL=postgres://tracera:change-me-to-a-random-value@127.0.0.1:5432/tracera
TRACERA_AUTO_MIGRATE=true

# Empty = ~/.tracera
TRACERA_DATA_DIR=
# Semicolon-separated absolute paths under which local repositories may be registered. Empty = none.
TRACERA_REPO_ROOTS=
# true makes npm start build the Bench Shop demo repository under TRACERA_DATA_DIR/fixtures when it is
# missing, so it can be registered from the web app.
TRACERA_DEMO_REPOS=false
# How many times npm start tries to reach the database before it exits non-zero (1 s pause, doubling up to 15 s).
TRACERA_DB_WAIT_ATTEMPTS=6

# Inference: mock | openai_compatible | meta  (mock needs no keys and makes no network calls)
TRACERA_INFERENCE_PROVIDER=mock

# openai_compatible placeholder (Nebius-hosted Muse Spark Open)
TRACERA_OPENAI_COMPAT_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TRACERA_OPENAI_COMPAT_API_KEY=
TRACERA_OPENAI_COMPAT_PROVIDER_NAME=nebius
# Required for openai_compatible (e.g. meta-models/muse-spark-open); defaults to muse-spark-1.3 for meta
TRACERA_MODEL_REASONING=

# Meta Model API, used when TRACERA_INFERENCE_PROVIDER=meta. Keep the key in the server environment only.
TRACERA_META_API_KEY=
TRACERA_META_BASE_URL=https://api.meta.ai/v1

TRACERA_LLM_DAILY_BUDGET_USD=5
TRACERA_LLM_MAX_CONCURRENCY=4
TRACERA_LLM_TIMEOUT_MS=120000
TRACERA_REDACT_EMAILS=true

# docker | disabled  (disabled records the sandbox stages as blocked instead of running them)
TRACERA_SANDBOX_MODE=docker

# Seed owner for local development (npm run db:seed)
TRACERA_SEED_OWNER_EMAIL=founder@example.com
TRACERA_SEED_OWNER_PASSWORD=

# Meetings. Model for extracting bug candidates from transcripts; empty = TRACERA_MODEL_REASONING
TRACERA_MODEL_MEETING=
# Google Meet import needs all four values. Create an OAuth client in a Google Cloud project; the
# redirect URI is your API origin plus /api/v1/integrations/google/callback. The encryption key seals
# stored OAuth tokens: 32 random bytes, base64 (node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TRACERA_ENCRYPTION_KEY=

# Screenshots. Model that reads attached screenshots; empty = a default for the inference provider
TRACERA_MODEL_VISION=
# Largest image, in bytes, that may be uploaded and sent to a model; empty = 8388608 (8 MB)
TRACERA_MAX_IMAGE_BYTES=
# Segmentation model that locates a named element in a screenshot; only the meta provider hosts one
TRACERA_MODEL_SEGMENT=
